# Banaras Darshan Environment Variables Template
# Copy this file to .env and configure your keys

# Database connection (SQLite default for local development, or PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://user:password@localhost:5432/banaras_darshan?schema=public"

# Authentication Secrets (NextAuth / Auth.js)
AUTH_SECRET="your-32-character-auth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Maps Provider Configuration
# Leaflet + OpenStreetMap works 100% out of the box with ZERO keys needed!
# If you wish to switch to Google Maps or Mapbox, provide keys below:
NEXT_PUBLIC_MAPS_PROVIDER="leaflet" # "leaflet" | "google" | "mapbox"
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Banaras AI Assistant Provider Configuration
# Built-in RAG reasoning engine works 100% locally out of the box.
# If connecting live cloud LLM (OpenAI or Gemini), provide keys:
AI_PROVIDER="local_verified" # "local_verified" | "gemini" | "openai"
AI_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Image Storage / CDN (Optional - Unsplash and SVG fallbacks work out of the box)
IMAGE_API_KEY=""
NEXT_PUBLIC_IMAGE_CDN_URL=""

# Real-time WebSocket Service Keys (Optional - SSE & local polling active by default)
REALTIME_SERVICE_KEYS=""
