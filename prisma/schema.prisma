// Prisma schema for Banaras Darshan

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  name        String
  avatar      String?
  bio         String?
  role        String   @default("USER") // USER, ADMIN, MODERATOR
  reputation  Int      @default(10)
  badge       String   @default("New Explorer") // New Explorer, Helpful Traveler, Local Guide, Trusted Contributor, Verified Contributor
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  savedPlaces SavedPlace[]
  trips       Trip[]
}

model Place {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  hindiName       String?
  category        String   // TEMPLE, GHAT, FOOD, HOTEL, STREET, EXPERIENCE, HIDDEN
  subCategory     String?  // e.g. "Morning Aarti", "Street Chaat", "Heritage Fort", "Weaving Colony", "Hostel"
  tagline         String
  description     String
  history         String?
  address         String
  area            String   // Assi, Dashashwamedh, Godowlia, Cantonment, Chowk, etc.
  latitude        Float
  longitude       Float
  image           String
  fallbackImage   String?
  rating          Float    @default(4.8)
  reviewCount     Int      @default(120)
  approxBudget    String   // e.g. "Free", "₹50 - ₹150", "₹1,500 - ₹3,500"
  budgetTier      String   // BUDGET, MID_RANGE, LUXURY, FREE
  bestTimeToVisit String?  // e.g. "5:00 AM - 7:30 AM", "Evening 6:00 PM"
  openingHours    String?
  visitingTips    String?
  safetyNotes     String?
  isVerified      Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  isHiddenGem     Boolean  @default(false)
  tags            String   // Comma separated tags
  popularDishes   String?  // For food
  isPureVeg       Boolean? @default(false)
  amenities       String?  // For stays: comma separated e.g. "Ghat View,WiFi,AC,Breakfast"
  nearestHub      String?  // e.g. "Cantt Railway Station: 4.5km"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  savedBy         SavedPlace[]
}

model CommunityMessage {
  id                 String   @id @default(cuid())
  userId             String
  userName           String
  userBadge          String   @default("New Explorer")
  userAvatar         String?
  channel            String   @default("general") // general, food, ghats, stays, help
  content            String
  image              String?
  isVerified         Boolean  @default(false)
  verifiedNote       String?
  status             String   @default("APPROVED") // APPROVED, HELD_FOR_REVIEW, REJECTED
  moderationScore    Float    @default(1.0)
  moderationReason   String?
  moderationCategory String?  @default("NONE") // NONE, VULGAR, ABUSE, SPAM, SCAM, HATE, UNSAFE
  helpfulCount       Int      @default(0)
  createdAt          DateTime @default(now())

  replies            CommunityReply[]
  reports            Report[]
}

model CommunityReply {
  id         String           @id @default(cuid())
  messageId  String
  userId     String
  userName   String
  userBadge  String           @default("New Explorer")
  content    String
  isVerified Boolean          @default(false)
  status     String           @default("APPROVED")
  createdAt  DateTime         @default(now())

  message    CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model Report {
  id            String            @id @default(cuid())
  reporterName  String            @default("Traveler")
  targetType    String            // MESSAGE, PLACE, USER
  targetId      String
  targetContent String?
  reason        String            // SPAM, ABUSE, HARASSMENT, FALSE_INFO, SCAM, UNSAFE, OTHER
  details       String?
  status        String            @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt     DateTime          @default(now())

  message       CommunityMessage? @relation(fields: [targetId], references: [id], onDelete: Cascade)
}

model ModerationLog {
  id          String   @id @default(cuid())
  action      String   // AUTO_FLAG, AUTO_REJECT, ADMIN_APPROVE, ADMIN_REJECT
  targetType  String
  targetId    String
  matchedRule String?
  severity    String?  // LOW, MEDIUM, HIGH, CRITICAL
  snippet     String?
  createdAt   DateTime @default(now())
}

model Trip {
  id            String   @id @default(cuid())
  userId        String?
  title         String
  durationDays  Int
  budgetTier    String
  travelStyle   String   // Spiritual, Foodie, Culture, Photography, Relaxation
  groupType     String   // Solo, Couple, Family, Friends
  itineraryJson String   // JSON string of days and activities
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SavedPlace {
  id        String   @id @default(cuid())
  userId    String
  placeId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  email     String?
  category  String   // GENERAL, INCORRECT_INFO, FEATURE_REQ, BUG, PRAISE
  rating    Int      @default(5)
  message   String
  status    String   @default("NEW") // NEW, REVIEWED, ACTIONED
  createdAt DateTime @default(now())
}

model PlaceSuggestion {
  id          String   @id @default(cuid())
  name        String
  category    String
  address     String
  description String
  speciality  String?
  submittedBy String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())
}
